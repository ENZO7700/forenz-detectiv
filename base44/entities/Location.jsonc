{
  "name": "Location",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "ID v\u00fdpovede, z ktorej miesto poch\u00e1dza"
    },
    "document_title": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "N\u00e1zov miesta"
    },
    "address": {
      "type": "string",
      "description": "Adresa, ak je v texte uveden\u00e1"
    },
    "source_quote": {
      "type": "string",
      "description": "Presn\u00fd doslovn\u00fd cit\u00e1t zo zdrojovej v\u00fdpovede"
    },
    "confidence": {
      "type": "number",
      "default": 0.5
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}